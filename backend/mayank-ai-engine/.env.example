# Copy this to .env and fill in real values. Never commit .env.

# Anthropic API key (get from console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# Which Claude model to use for review/slop/RCA/patch calls
CLAUDE_MODEL=claude-sonnet-5

PORT=4001

# Set to "true" to log full prompts/responses to console (dev only - do NOT
# do this against real customer code, could leak source into logs)
DEBUG_LLM=false

# ==================================================
# STRUCTURAI BACKEND PRODUCTION ENVIRONMENT CONFIGURATION
# ==================================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
APP_BASE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Connection (MongoDB Atlas in Production)
MONGODB_URI=mongodb://localhost:27017/structurAl

# GitHub OAuth Integration (REQUIRED)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret

# Security & Secrets (REQUIRED IN PRODUCTION)
SESSION_SECRET=your_super_secret_session_key_min_32_bytes
GITHUB_TOKEN_ENCRYPTION_KEY=64_character_hex_string_representing_32_bytes

# Agora RTC Real-Time Communication (REQUIRED IN PRODUCTION FOR AUDIO/VIDEO)
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate

# Slack Bot Integration (OPTIONAL)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL_ID=C0123456789

# Email Delivery & Project Invitations (OPTIONAL)
EMAIL_SERVICE=gmail
EMAIL_USER=notifications@your-domain.com
EMAIL_PASSWORD=your_smtp_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# AI Telemetry & Code Engine (OPTIONAL)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
